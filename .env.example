# Environment Mode
NODE_ENV=development
PORT=3001

# Database Configuration (PostgreSQL in production; SQLite supported for zero-friction local development)
DATABASE_URL=file:./dev.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gametopup_db?schema=public

# Application URLs. Use public HTTPS URLs in production; localhost cannot
# receive a payment success return on a customer's phone.
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# AnajakPay / ABA Pay Direct QR (server-side only; never expose the secret to the browser)
KHQRCC_ENABLED=false
KHQRCC_BASE_URL=https://anajakpay.com
KHQRCC_CHECKOUT_URL=https://anajakpay.com/api/payment/requestv2
KHQRCC_PROFILE_ID=your_anajakpay_profile_id
KHQRCC_SECRET_KEY=your_anajakpay_secret_key
KHQRCC_SESSION_SECONDS=420
KHQRCC_WEBHOOK_TIMEOUT_MINUTES=5
# Reject signed payment callbacks older than this replay window.
KHQRCC_WEBHOOK_MAX_AGE_SECONDS=300
PAYMENT_POLL_INTERVAL_SECONDS=30
PAYMENT_POLL_LIMIT=50
PAYMENT_POLL_MAX_AGE_MINUTES=1440

# Security & Secrets
AUTH_SECRET=super_secret_session_key_min_32_characters_long_12345
INTERNAL_API_SECRET=internal_api_secret_for_cron_and_services_98765
CRON_SECRET=strong_cron_secret_for_cron_job_org_54321
# Local setup credential from cron-job.org Console > Settings (do not expose publicly)
CRON_JOB_ORG_API_KEY=
CRON_JOB_ORG_URL=https://natopup.com/api/internal/cron/all
ADMIN_SECRET_KEY=admin_secret_passphrase_2026
ADMIN_EMERGENCY_IP_SECRET=generate_a_random_secret_with_at_least_32_characters
ADMIN_INITIAL_PASSWORD=change-this-to-a-long-password
# Comma-separated IPv4/IPv6 addresses allowed to open the admin login.
ADMIN_ALLOWED_IPS=127.0.0.1
ADMIN_DASHBOARD_ORIGIN=http://localhost:5173

# KHQR Payment Gateway (KHQR.cc / Verify V2 / Bakong)
KHQR_API_BASE_URL=https://api.khqr.cc/v1
KHQR_API_KEY=your_khqr_api_key_here
KHQR_API_SECRET=your_khqr_api_secret_here
KHQR_WEBHOOK_SECRET=your_khqr_webhook_secret_here
KHQR_MERCHANT_ID=LUKAS_TOPUP_KHQR
KHQR_MERCHANT_NAME=LUKAS GAME TOPUP
KHQR_TERMINAL_ID=TERM001
KHQR_CURRENCY=USD

# G2Bulk Supplier API
G2BULK_BASE_URL=https://api.g2bulk.com/v1
G2BULK_API_KEY=your_g2bulk_api_key_here
G2BULK_CALLBACK_URL=https://your-backend.example.com/api/webhooks/g2bulk

# Vizo Supplier API (vizoapp.store)
VIZO_BASE_URL=https://api.vizoapp.store
VIZO_API_KEY=your_vizo_api_key_here
VIZO_CALLBACK_URL=https://your-backend.example.com/api/webhooks/vizo

# Price Protection & Business Rules
MAX_SUPPLIER_PRICE_SURGE_PERCENT=5.0
USD_TO_KHR_RATE=4100
LOG_LEVEL=info

# Telegram order alerts (server-side only). For forum links in the form
# https://t.me/c/CHAT/TOPIC/MESSAGE, use chat ID -100CHAT and TOPIC as the
# thread ID. Never prefix these variables with NEXT_PUBLIC_ or VITE_.
TELEGRAM_BOT_TOKEN_TOPIC=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=-1000000000000
TELEGRAM_PAID_THREAD_ID=4
TELEGRAM_COMPLETED_THREAD_ID=2
TELEGRAM_SYSTEM_THREAD_ID=6
TELEGRAM_LOW_BALANCE_G2B_THREAD_ID=22
TELEGRAM_LOW_BALANCE_VIZO_THREAD_ID=25
TELEGRAM_LOW_BALANCE_THRESHOLD_USD=3
